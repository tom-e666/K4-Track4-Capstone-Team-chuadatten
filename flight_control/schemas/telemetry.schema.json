                },
                "minItems": 3,
                "maxItems": 3
              }
            }
          }
        },
        "normal_contact_impulse_Ns": {
          "type": "number"
        },
        "total_impulse_world_Ns": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "total_average_force_approx_world_N": {
