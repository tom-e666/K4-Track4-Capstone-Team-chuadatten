              "post_impact_point_velocity_world_m_s"
            ],
            "properties": {
              "contact_id": {
                "type": "string",
                "pattern": "^box_corner_[0-7]$"
              },
              "region": {
                "const": "simulated_rigid_body_corner"
              },
              "position_body_m": {
                "type": "array",
