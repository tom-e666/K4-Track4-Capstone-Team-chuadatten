        "solver_iterations",
        "force_time_assumption_s",
        "true_peak_contact_force_N",
        "unavailable_reason"
      ],
      "properties": {
        "contacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
