                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "average_normal_force_approx_N": {
                "type": "number"
              },
              "angular_impulse_about_CG_world_Nms": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "pre_impact_point_velocity_world_m_s": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
